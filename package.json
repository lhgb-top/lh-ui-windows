{
  "name": "@lh-ui/windows",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "lh-ui 原生血脉 Windows 端：C# + WinUI 3 UI 库（构建期工具脚本，非运行时）",
  "license": "Apache-2.0",
  "author": "lhgb <i@lhgb.top>",
  "homepage": "https://www.lhgb.top/lhui/windows/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhgb-top/lh-ui-windows.git"
  },
  "bugs": {
    "url": "https://github.com/lhgb-top/lh-ui-windows/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "link:tokens": "node scripts/link-tokens.mjs",
    "link:tokens:check": "node scripts/link-tokens.mjs --check",
    "gen:sim": "node scripts/gen-sim-tokens.mjs",
    "gen:docs": "node scripts/gen-doc-pages.mjs",
    "sim:check": "node scripts/check-sim-vars.mjs",
    "docs:dev": "pnpm gen:sim && vitepress dev docs --port 5186",
    "docs:build": "pnpm gen:sim && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:app": "dotnet run --project docsapp",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-version.mjs",
    "release:push": "node scripts/push-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  },
  "sideEffects": false
}
